# Workers static assets uploads the whole assets directory, which here is the
# repo root — including anything the build step creates. Without this, `npx
# wrangler deploy` installs wrangler into ./node_modules and then tries to
# upload its own workerd binary, which exceeds the 25 MiB asset limit.
#
# EVERY DIRECTORY PATTERN IS ANCHORED WITH A LEADING SLASH ON PURPOSE.
# An unanchored name matches a path component at ANY depth, so a bare "STEMS"
# also matched content/*/stems/ and silently dropped all 19 audio files from
# the deploy — the site built green and 404'd on every stem.
/node_modules/
/.git/
/_to_delete/
/tools/
/test/
/Panels/

# not needed at runtime
/.gitignore
/.assetsignore
/wrangler.jsonc
/package.json
/package-lock.json
/bun.lockb
/serve.sh
/README.md
.DS_Store

# consumed as config, not served as a file
/_headers

# The raw multitrack exports are gitignored, so they never reach the build
# machine at all. No pattern needed — and adding one is what broke this.
